    {
      "parameters": {
        "jsCode": "// const incomingEmail = $('Gmail Trigger').first().json.From\n\n// const incomingEmail = \"bob.jones@example.com\"\n\nconst incomingEmail = \"alice.smith@example.com\"\n\n// const requestData = $('Gmail Trigger').first().json.snippet\n\nconst requestedDays = $('AI Agent').first().json.output.days_requested\n\n//append requestedDays inside the json\nfor (const item of $input.all()) {\n  if (item.json.Email === incomingEmail) {\n    item.json.requestedDays = requestedDays;\n    return item;\n  }\n}\nthrow new Error('Employee not found in CSV');"
      },
      "id": "72114c96-7f09-4706-aaa8-d0e81c47e9eb",
